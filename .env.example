# API Gateway
PORT=8080

# Auth Service
AUTH_PORT=8082

# User Service
USER_PORT=8083

# Videos Service
VIDEOS_PORT=8081

# Database
DATABASE_URL=postgresql://postgres:password@postgres:5432/auth_db

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Node Environment
NODE_ENV=development
